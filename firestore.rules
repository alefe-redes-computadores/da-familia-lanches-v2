rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches("(?i)alefejohsefe@gmail.com") ||
        request.auth.token.email.matches("(?i)kalebhstanley650@gmail.com") ||
        request.auth.token.email.matches("(?i)contato@dafamilialanches.com.br") ||
        request.auth.token.email.matches("(?i)carols2maite@gmail.com") ||
        request.auth.token.email.matches("(?i)degustbolosnopote@gmail.com") ||
        request.auth.token.email.matches("(?i)viniciusrdefreitas@gmail.com")
      );
    }

    match /Pedidos/{documentId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ["Pendente", "Agendado"]
        && request.resource.data.tipoEntrega in ["delivery", "pickup"]
        && request.resource.data.subtotal is number
        && request.resource.data.total is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.total >= 0;
      allow read, list: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }


    match /integration_outbox/{eventId} {
      allow create: if request.auth != null
        && eventId == request.resource.data.event_id
        && request.resource.data.event_id is string
        && request.resource.data.event_type in ["order.created", "order.updated"]
        && request.resource.data.occurred_at is string
        && request.resource.data.source_system == "dfl_site"
        && request.resource.data.entity_type == "order"
        && request.resource.data.entity_id is string
        && request.resource.data.schema_version == 1
        && request.resource.data.payload is map
        && request.resource.data.status == "pending"
        && request.resource.data.attempts == 0
        && request.resource.data.created_at is string
        && request.resource.data.updated_at is string
        && request.resource.data.payload.orderId == request.resource.data.entity_id
        && request.resource.data.payload.sourceSystem == "dfl_site"
        && request.resource.data.payload.userId is string
        && request.resource.data.payload.orderSchemaVersion is number
        && (
          (
            request.resource.data.event_type == "order.created"
            && request.resource.data.payload.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.userId == request.auth.uid
            && request.resource.data.payload.orderSchemaVersion
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.orderSchemaVersion
            && request.resource.data.payload.tipoEntrega
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.tipoEntrega
            && request.resource.data.payload.status
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.status
            && request.resource.data.payload.subtotal
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.subtotal
            && request.resource.data.payload.taxaEntrega
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.taxaEntrega
            && request.resource.data.payload.desconto
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.desconto
            && request.resource.data.payload.total
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.total
            && request.resource.data.payload.metodoPagamento
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.metodoPagamento
            && request.resource.data.payload.itens
              == getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.entity_id)).data.itens
          )
          ||
          (
            request.resource.data.event_type == "order.updated"
            && isAdmin()
          )
        );

      allow read, list, update, delete: if isAdmin();
    }

    match /Entregadores/{entregadorId} { allow read, write: if isAdmin(); }
    match /settings/{documentId} { allow read: if true; allow write: if isAdmin(); }
    match /Cupons/{cupomId} { allow get: if true; allow list: if isAdmin(); allow create, update, delete: if isAdmin(); }
    match /RecompensasConfig/{documentId} { allow read: if true; allow write: if isAdmin(); }
    match /CuponsUsuarios/{documentId} { allow read: if request.auth != null && request.auth.uid == documentId; allow write: if isAdmin(); }

    match /Usuarios/{userId}/RecompensasRecebidas/{documentId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "used",
          "usedAt",
          "usedOrderId"
        ])
        && request.resource.data.usedOrderId is string
        && getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.usedOrderId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.usedOrderId)).data.rewardId == documentId
        && getAfter(/databases/$(database)/documents/Pedidos/$(request.resource.data.usedOrderId)).data.cupom == resource.data.code
      );
    }

    match /Usuarios/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /TaxasDeEntrega/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      match /{subCollection}/{subDoc} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /CatalogoCategorias/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /CatalogoProdutos/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /CatalogoAdicionais/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
